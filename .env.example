# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# On Hostinger you create the MySQL database + user in hPanel → Databases → MySQL.

# ---- Run without a database (local dev) ----
# Set to true to skip MySQL entirely and store everything in a local JSON file
# (data/db.json). Leave false/unset to use the MySQL connection below.
DB_DISABLED=false

# ---- MySQL / MariaDB connection ----
DB_HOST=localhost
DB_PORT=3306
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=your_db_name

# ---- App ----
# Any long random string. Generate one with:  openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string

# Port the Node server listens on (Nginx proxies to this).
PORT=3000

# Optional: fixed USD→INR rate used when the live rate API is unreachable.
USD_INR_FALLBACK=87

# Optional: Groq API key for the conversational features (leave blank if unused).
GROQ_API_KEY=
