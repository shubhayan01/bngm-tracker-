# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# On Hostinger you create the MySQL database + user in hPanel → Databases → MySQL.

# ---- Run without a database (local dev) ----
# Set to true to skip MySQL entirely and store everything in a local JSON file
# (data/db.json). Leave false/unset to use the MySQL connection below.
# NOTE: on Railway/Render the container disk is wiped on every redeploy, so the
# file store is fine for local dev but does NOT persist in the cloud — use
# Firestore (below) there.
DB_DISABLED=false

# ---- Firestore (free, persistent, non-SQL — recommended for Railway) ----
# When configured, this takes precedence over the file store AND MySQL, and the
# data survives redeploys. Paste the WHOLE service-account JSON (from the Firebase
# console → Project settings → Service accounts → Generate new private key) into
# one variable. On Railway, a multi-line value pastes fine; a base64-encoded blob
# also works.
FIREBASE_SERVICE_ACCOUNT=
# --- OR the three fields individually (instead of the JSON above) ---
# FIREBASE_PROJECT_ID=your-project-id
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxx@your-project-id.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# --- optional: the Firestore collection that holds the store (default kv_store) ---
# FIRESTORE_COLLECTION=kv_store

# ---- MySQL / MariaDB connection ----
DB_HOST=localhost
DB_PORT=3306
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=your_db_name

# ---- App ----
# Any long random string. Generate one with:  openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string

# Port the Node server listens on (Nginx proxies to this).
PORT=3000

# Optional: fixed USD→INR rate used when the live rate API is unreachable.
USD_INR_FALLBACK=87

# Optional: Groq API key for the conversational features (leave blank if unused).
GROQ_API_KEY=
